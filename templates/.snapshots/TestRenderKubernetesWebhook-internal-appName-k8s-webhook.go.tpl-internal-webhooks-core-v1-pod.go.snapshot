// MarshalLog implements log.Marshaler for use in logging/tracing/metrics
func (r *PodWebhook) MarshalLog(addField func(k string, v interface{})) {
	addField("resource.kind", "Pod")
	addField("resource.version", "v1")
	addField("controller.type", "webhook")
}

// Kind returns the k8s kind served by this webhook
func (r *PodWebhook) Kind() string {
	return "Pod"
}

// Version returns the version of this webhook
func (r *PodWebhook) Version() string {
	// we always lowercase the version when used with K8s
	return "v1"
}

// Setup registers the PodWebhook as a webhook with the manager.
func (r *PodWebhook) Setup(mgr ctrl.Manager) error {
	// all relevant validation or other webhook related methods must be defined on the Pod itself
	err := ctrl.NewWebhookManagedBy(mgr).
		For(&apiv1.Pod{}).
		Complete()
	if err != nil {
		log.Error(context.Background(), "failed to register webhook handler", r, events.Err(err))
	}
	return err
}

