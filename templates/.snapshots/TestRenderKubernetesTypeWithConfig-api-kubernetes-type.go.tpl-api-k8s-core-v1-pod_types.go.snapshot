// Pod is an alias to corev1.Pod
// +kubebuilder:object:root=true
type Pod struct {
	corev1.Pod `json:",inline"`
	cfg *config.Config
}

// NewPod creates a new Pod with config.
func NewPod(cfg *config.Config) *Pod {
	return &Pod{cfg: cfg}
}

// PodList is an alias to corev1.PodList
// +kubebuilder:object:root=true
type PodList corev1.PodList

// MarshalLog can be used to add resource fields to log, satisfies resources.Resource interface.
func (r *Pod) MarshalLog(addfield func(key string, value interface{})) {
	addfield("resource.name", r.Name)
	addfield("resource.namespace", r.Namespace)
}

