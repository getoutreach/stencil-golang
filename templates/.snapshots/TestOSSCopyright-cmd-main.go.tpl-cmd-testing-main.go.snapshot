// Description: This file is the entrypoint for testing.
// Managed: true

// Package main implements the main entrypoint for the testing service.
package main

import (
	"context"
	"os"
	"time"

	"github.com/getoutreach/gobox/pkg/app"
	"github.com/getoutreach/gobox/pkg/async"
	"github.com/getoutreach/gobox/pkg/env"
	"github.com/getoutreach/gobox/pkg/log"
	"github.com/getoutreach/gobox/pkg/events"
	"github.com/getoutreach/gobox/pkg/olog"
	"github.com/getoutreach/gobox/pkg/trace"
	"github.com/getoutreach/stencil-golang/pkg/serviceactivities/automemlimit"
	"github.com/getoutreach/stencil-golang/pkg/serviceactivities/shutdown"
	"github.com/getoutreach/stencil-golang/pkg/serviceactivities/gomaxprocs"
	"github.com/pkg/errors"

	// Place any extra imports for your startup code here
	// <<Stencil::Block(imports)>>

	// <</Stencil::Block>>
)

// Place any customized code for your service in this block.
//
// <<Stencil::Block(customized)>>

// <</Stencil::Block>>

// dependencies is a conglomerate struct used for injecting dependencies into service
// activities.
type dependencies struct{
	privateHTTP testing.PrivateHTTPDependencies
	// <<Stencil::Block(customServiceActivityDependencyInjection)>>

	// <</Stencil::Block>>
}

// main is the entrypoint for the testing service.
func main() { //nolint:nolintlint,funlen // Why: We can't dwindle this down anymore without adding complexity.
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()

	exitCode := 1
	defer func() {
		if r := recover(); r != nil {
			log.Error(ctx, "unhandled panic", events.NewErrorInfoFromPanic(r))
			panic(r)
		}
		os.Exit(exitCode)
	}()

	env.ApplyOverrides()
	app.SetName("testing")

	cfg, err := testing.LoadConfig(ctx)
	if err != nil {
		log.Error(ctx, "failed to load config", events.NewErrorInfo(err))
		return
	}

	if err := trace.InitTracer(ctx, "testing"); err != nil {
		log.Error(ctx, "tracing failed to start", events.NewErrorInfo(err))
		return
	}
	defer trace.CloseTracer(ctx)

	// Initialize variable for service activity dependency injection.
	var deps dependencies

	log.Info(ctx, "starting", app.Info(), cfg, log.F{"app.pid": os.Getpid()})

	// Watch the log-level configuration file (mounted from the "logging"
	// ConfigMap generated by stencil-golang) so log levels can be changed
	// live without a restart. The ConfigMap is mounted as a directory (no
	// subPath), so the kubelet propagates updates automatically:
	// https://kubernetes.io/docs/concepts/storage/volumes/#configmap
	logLevelsPath := os.Getenv("LOG_LEVELS_CONFIG_PATH")
	if logLevelsPath == "" {
		logLevelsPath = "/run/config/outreach.io/log-levels/log-levels.yaml"
	}
	go olog.PollConfigurationFile(ctx, logLevelsPath, 30*time.Second, func(err error) bool {
		if err != nil {
			log.Warn(ctx, "failed to apply log level configuration", events.NewErrorInfo(err),
				log.F{"path": logLevelsPath})
		} else {
			log.Info(ctx, "applied log level configuration", log.F{"path": logLevelsPath})
		}
		return true
	})

	// Place any code for your service to run before registering service activities in this block
	// <<Stencil::Block(initialization)>>

	// <</Stencil::Block>>

	acts := []async.Runner{
		shutdown.New(),
		gomaxprocs.New(),
		automemlimit.New(),
		testing.NewHTTPService(cfg, &deps.privateHTTP),

		// Place any additional ServiceActivities that your service has
		// built here to have them handled automatically.
		//
		// <<Stencil::Block(services)>>

		// <</Stencil::Block>>
	}

	// Place any code for your service to run during startup in this block.
	//
	// <<Stencil::Block(startup)>>

	// <</Stencil::Block>>

	err = async.RunGroup(acts).Run(ctx)
	if shutdown.HandleShutdownConditions(ctx, err) {
		exitCode = 0
	}
}
)
